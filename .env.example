NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional transactional onboarding email. Keep both empty to use the secure copy-link fallback.
# From address must belong to a verified Resend sending domain, e.g. Nusantara Star <hello@your-domain.com>
RESEND_API_KEY=
NUSANTARA_STAR_EMAIL_FROM=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BIO_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_RIDER_FALLBACK_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-5.4-mini
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=nusantara-star-talent-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://nusantarastar.com/api/talent-onboarding/google-calendar/callback
# Optional. If empty, V1 derives a token-encryption key from SUPABASE_SERVICE_ROLE_KEY.
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
